<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:s="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:upupt"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             targetNamespace="urn:upupt">
  <types>
    <s:schema targetNamespace="urn:upupt" elementFormDefault="qualified">
      <s:element name="SearchPosts">
        <s:complexType>
          <s:sequence>
            <s:element name="keyword" type="s:string"/>
            <s:element name="user_id" type="s:unsignedLong"/>
            <s:element name="page" type="s:unsignedInt"/>
            <s:element name="page_size" type="s:unsignedInt"/>
            <s:element name="sort" type="s:string"/>
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="SearchPostsResponse">
        <s:complexType>
          <s:sequence>
            <s:element name="items">
              <s:complexType>
                <s:sequence>
                  <s:element name="item" minOccurs="0" maxOccurs="unbounded">
                    <s:complexType>
                      <s:sequence>
                        <s:element name="userId" type="s:unsignedLong"/>
                        <s:element name="id" type="s:unsignedLong"/>
                        <s:element name="title" type="s:string"/>
                        <s:element name="body" type="s:string"/>
                      </s:sequence>
                    </s:complexType>
                  </s:element>
                </s:sequence>
              </s:complexType>
            </s:element>
            <s:element name="total" type="s:unsignedInt"/>
            <s:element name="page" type="s:unsignedInt"/>
            <s:element name="page_size" type="s:unsignedInt"/>
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="RenderPhoto">
        <s:complexType>
          <s:sequence>
            <s:element name="scene" type="s:string"/>
            <s:element name="width" type="s:unsignedInt"/>
            <s:element name="height" type="s:unsignedInt"/>
            <s:element name="format" type="s:string"/>
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="RenderPhotoResponse">
        <s:complexType>
          <s:sequence>
            <s:element name="scene" type="s:string"/>
            <s:element name="width" type="s:unsignedInt"/>
            <s:element name="height" type="s:unsignedInt"/>
            <s:element name="format" type="s:string"/>
            <s:element name="image">
              <s:complexType>
                <s:sequence>
                  <s:element name="filename" type="s:string"/>
                  <s:element name="mime" type="s:string"/>
                  <s:element name="size" type="s:unsignedLong"/>
                  <s:element name="base64" type="s:string"/>
                </s:sequence>
              </s:complexType>
            </s:element>
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="CompareImage">
        <s:complexType>
          <s:sequence>
            <s:element name="filename" type="s:string"/>
            <s:element name="image" type="s:string"/>
            <s:element name="threshold" type="s:unsignedInt"/>
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="CompareImageResponse">
        <s:complexType>
          <s:sequence>
            <s:element name="matched" type="s:boolean"/>
            <s:element name="filename" type="s:string"/>
            <s:element name="distance" type="s:unsignedInt"/>
            <s:element name="threshold" type="s:unsignedInt"/>
          </s:sequence>
        </s:complexType>
      </s:element>
    </s:schema>
  </types>
  <message name="SearchPostsIn"><part name="body" element="tns:SearchPosts"/></message>
  <message name="SearchPostsOut"><part name="body" element="tns:SearchPostsResponse"/></message>
  <message name="RenderPhotoIn"><part name="body" element="tns:RenderPhoto"/></message>
  <message name="RenderPhotoOut"><part name="body" element="tns:RenderPhotoResponse"/></message>
  <message name="CompareImageIn"><part name="body" element="tns:CompareImage"/></message>
  <message name="CompareImageOut"><part name="body" element="tns:CompareImageResponse"/></message>
  <portType name="Upupt">
    <operation name="SearchPosts">
      <input message="tns:SearchPostsIn"/>
      <output message="tns:SearchPostsOut"/>
    </operation>
    <operation name="RenderPhoto">
      <input message="tns:RenderPhotoIn"/>
      <output message="tns:RenderPhotoOut"/>
    </operation>
    <operation name="CompareImage">
      <input message="tns:CompareImageIn"/>
      <output message="tns:CompareImageOut"/>
    </operation>
  </portType>
  <binding name="UpuptSoap" type="tns:Upupt">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
    <operation name="SearchPosts">
      <soap:operation soapAction="SearchPosts"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="RenderPhoto">
      <soap:operation soapAction="RenderPhoto"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="CompareImage">
      <soap:operation soapAction="CompareImage"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="UpuptService">
    <port name="UpuptSoap" binding="tns:UpuptSoap">
      <soap:address location="/soap"/>
    </port>
  </service>
</definitions>
